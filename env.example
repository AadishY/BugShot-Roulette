# ==========================================
# CLIENT (Vite Front-end) Environment Variables
# ==========================================
# Backend API & WebSocket Server URLs
VITE_SERVER_URL=http://localhost:3001
VITE_SOCKET_URL=http://localhost:3001
VITE_HF_BACKEND_URL=https://yoakatsuki-buckshot.hf.space

# Firebase Cloud Configuration
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-ABCDEF1234

# ==========================================
# SERVER (Node/Express Backend) Environment Variables
# ==========================================
PORT=3001

# Allowed CORS Origins (Comma-separated URLs or * for all)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://your-frontend-domain.com